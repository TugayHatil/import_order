<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_log_config_view_tree" model="ir.ui.view">
        <field name="name">product.log.config.view.tree</field>
        <field name="model">product.log.config</field>
        <field name="arch" type="xml">
            <tree editable="bottom">
                <field name="field_id" options="{'no_create': True, 'no_open': True}"/>
                <field name="model_id"/>
                <field name="field_name"/>
                <field name="field_description"/>
            </tree>
        </field>
    </record>

    <record id="product_log_config_action" model="ir.actions.act_window">
        <field name="name">Product Log Configuration</field>
        <field name="res_model">product.log.config</field>
        <field name="view_mode">tree</field>
    </record>

    <menuitem id="menu_product_log_config"
              name="Product Log"
              parent="stock.menu_stock_config_settings"
              action="product_log_config_action"
              sequence="100"/>
</odoo>
