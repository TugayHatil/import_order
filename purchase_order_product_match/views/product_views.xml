<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Product Template Form View -->
    <record id="product_template_form_view_inherit_manufacturer_pref" model="ir.ui.view">
        <field name="name">product.template.form.inherit.manufacturer.pref</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='default_code']" position="after">
                <field name="manufacturer_pref"/>
            </xpath>
        </field>
    </record>

    <!-- Product Product Form View -->
    <record id="product_normal_form_view_inherit_manufacturer_pref" model="ir.ui.view">
        <field name="name">product.product.form.inherit.manufacturer.pref</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_normal_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='default_code']" position="after">
                <field name="manufacturer_pref"/>
            </xpath>
        </field>
    </record>

    <!-- Product Product Tree View -->
    <record id="product_product_tree_view_inherit_manufacturer_pref" model="ir.ui.view">
        <field name="name">product.product.tree.inherit.manufacturer.pref</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_product_tree_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='default_code']" position="after">
                <field name="manufacturer_pref" optional="show"/>
            </xpath>
        </field>
    </record>
</odoo>
