<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_employee_form_inherit_tab_filter" model="ir.ui.view">
        <field name="name">hr.employee.form.inherit.tab.filter</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <!-- Dinamik görünürlüğü kontrol eden alanı forma ekliyoruz (invisible olarak) -->
            <xpath expr="//field[@name='company_id']" position="after">
                <field name="is_private_tab_visible" invisible="1"/>
            </xpath>
            
            <!-- 'personal_information' sekmesinin (page) görünürlüğünü attrs ile kısıtlıyoruz -->
            <xpath expr="//page[@name='personal_information']" position="attributes">
                <attribute name="attrs">{'invisible': [('is_private_tab_visible', '=', False)]}</attribute>
            </xpath>
        </field>
    </record>
</odoo>
