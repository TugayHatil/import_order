<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_picking_type_form_inherit_import" model="ir.ui.view">
        <field name="name">stock.picking.type.form.inherit.import</field>
        <field name="model">stock.picking.type</field>
        <field name="inherit_id" ref="stock.view_picking_type_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='code']" position="after">
                <field name="x_is_import_type" string="Is Import Type?" help="If checked, this picking type will be used for import shipments."/>
            </xpath>
        </field>
    </record>
</odoo>
